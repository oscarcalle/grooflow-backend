    },
    {
      "name": "3. Casos de verificación (Alanies / DNI)",
      "description": "Ayuda a validar el caso Sync Buk por DNI (ej. 73704491).",
      "item": [
        {
          "name": "Buscar empleado Buk.pe por document_number (script)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ajusta el DNI a buscar:",
                  "pm.variables.set('lookupDni', pm.collectionVariables.get('lookupDni') || '73704491');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dni = String(pm.variables.get('lookupDni') || '73704491').replace(/\\D+/g, '');",
                  "pm.test('HTTP 2xx', () => pm.response.to.be.success);",
                  "const j = pm.response.json();",
                  "const rows = Array.isArray(j.data) ? j.data : [];",
                  "const hit = rows.find(r => String(r.document_number || '').replace(/\\D+/g, '') === dni);",
                  "if (hit) {",
                  "  console.log('FOUND page', pm.collectionVariables.get('page'), {",
                  "    id: hit.id,",
                  "    status: hit.status,",
                  "    document_number: hit.document_number,",
                  "    email: hit.email,",
                  "    cargo: hit.current_job && hit.current_job.role && hit.current_job.role.name,",
                  "    area: hit.current_job && hit.current_job.role && hit.current_job.role.role_family && hit.current_job.role.role_family.name",
                  "  });",
                  "  pm.test('Encontrado en esta página', () => pm.expect(hit).to.be.ok);",
                  "} else {",
                  "  console.warn('No está en page=' + (pm.collectionVariables.get('page') || '1') + ' — prueba otras páginas.');",
                  "  pm.test('Respuesta válida (puede no estar en esta página)', () => pm.expect(rows).to.be.an('array'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "auth_token", "value": "{{bukPeToken}}", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{bukPeBaseUrl}}/employees?page={{page}}&page_size={{pageSize}}",
              "host": ["{{bukPeBaseUrl}}"],
              "path": ["employees"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "page_size", "value": "{{pageSize}}" }
              ]
            },
            "description": "Busca en la página actual el DNI `73704491` (Alanies). Cambia `page` si no aparece.\n\nEn MySQL debería mapear a `grooflow_buk_empleados.document_number` y luego Sync → `app_usuarios.identificacion` + `puesto=cargo`."
          }
        },
        {
          "name": "Buscar DNI en asistencia-empresa (script)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dni = '73704491';",
                  "pm.test('HTTP 2xx', () => pm.response.to.be.success);",
                  "const j = pm.response.json();",
                  "const rows = Array.isArray(j.data) ? j.data : [];",
                  "const hits = rows.filter(r => String(r.rut_trabajador || r.DNI || r.dni || '').replace(/\\D+/g, '') === dni);",
                  "console.log('hits', hits.length, hits[0] || null);",
                  "pm.test('Lista válida', () => pm.expect(rows).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "token", "value": "{{ctrlitToken}}", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{ctrlitBaseV2}}/asistencia-empresa?page=1&page_size={{pageSize}}",
              "host": ["{{ctrlitBaseV2}}"],
              "path": ["asistencia-empresa"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "{{pageSize}}" }
              ]
            },
            "description": "Si Alanies no tiene turno en `grooflow_buk_empleados`, suele ser porque Ctrlit no trae marcación/turno para ese DNI."
          }
        }
      ]
    }
  ]
